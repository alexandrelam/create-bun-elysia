# Deployment env for docker compose. Copy to .env on the server and fill in.
# (For local development, use apps/api/.env instead.)

# Public origin the browser hits (used by Better Auth for OAuth callbacks).
BETTER_AUTH_URL=https://__APP_NAME__.example.com

# Signing key for sessions: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud console > Credentials > OAuth 2.0 Client ID (Web application).
# Authorized redirect URI must include: $BETTER_AUTH_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Port published on the host's localhost (the container always listens on 3000).
HOST_PORT=3000
