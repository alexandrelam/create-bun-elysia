# The project's only env file, for dev and production. Copy to .env (gitignored) and fill in.
# In dev, the API scripts load it with --env-file; in production, docker compose reads it.

# Public origin the browser hits (used by Better Auth for OAuth callbacks).
# Dev: the Vite server, which proxies /api to the API. Production: e.g. https://__APP_NAME__.example.com
BETTER_AUTH_URL=http://localhost:5173

# Signing key for sessions: openssl rand -base64 32 (use a different one in production)
BETTER_AUTH_SECRET=

# Google Cloud console > Credentials > OAuth 2.0 Client ID (Web application).
# Authorized redirect URI must include: $BETTER_AUTH_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev only: docker compose overrides these in the container.
PORT=3000
DATABASE_URL=data/app.db

# Production only: port published on the host's localhost (the container always listens on 3000).
HOST_PORT=3000
