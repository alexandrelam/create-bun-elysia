{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "apps/api/drizzle/",
    "apps/api/src/shared/db/schema/auth.ts"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",

    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-statements": "off",
    "eslint/max-params": "off",
    "import/max-dependencies": "off",

    "eslint/no-inline-comments": "off",

    "unicorn/no-useless-undefined": ["error", { "checkArguments": false }],

    "import/no-unassigned-import": "off",

    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "./*/**",
              "!./shared/*",
              "./shared/*/**",
              "../*/**",
              "!../shared/*",
              "../shared/*/**",
              "../../*/**",
              "!../../shared/*",
              "../../shared/*/**"
            ],
            "message": "Import another module through its index.ts (e.g. \"../auth\", \"../shared/db\"), never its internal files."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/web/**"],
      "env": { "browser": true }
    },
    {
      "files": ["apps/api/**", "**/*.config.ts"],
      "env": { "node": true }
    }
  ]
}
